# Copy to .env.local and fill in. Never commit real values.

# --- App ---
# Public URL of the app (used for auth redirects and links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true = show demo credentials on the login page and send emails to the in-app Outbox
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only: seed script and admin actions. Bypasses RLS.
SUPABASE_SECRET_KEY=
# Used by the Supabase CLI for migrations and type generation
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Demo users (created by the seed script) ---
DEMO_CEO_EMAIL=ceo@demo.ptdealdesk.ng
DEMO_CEO_PASSWORD=
DEMO_ACCOUNTANT_EMAIL=accountant@demo.ptdealdesk.ng
DEMO_ACCOUNTANT_PASSWORD=

# --- Email (Resend). Not used while NEXT_PUBLIC_DEMO_MODE=true ---
RESEND_API_KEY=
EMAIL_FROM="P&T Deal Desk <no-reply@example.com>"
