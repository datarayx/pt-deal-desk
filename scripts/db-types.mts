// Generates src/types/database.ts from the live schema (task 1.4).
//
// Run:  npm run db:types      (reads SUPABASE_DB_URL from .env.local; re-run after every migration)
//
// The connection string is passed straight to the Supabase CLI (no shell) and never printed.

import { spawnSync } from "node:child_process";
import { writeFileSync } from "node:fs";
import { join } from "node:path";

const dbUrl = process.env.SUPABASE_DB_URL;
if (!dbUrl) {
  console.error("Missing SUPABASE_DB_URL in .env.local (see .env.example).");
  process.exit(1);
}

const cli = join(process.cwd(), "node_modules", "supabase", "dist", "supabase.js");
const result = spawnSync(
  process.execPath,
  [cli, "gen", "types", "--lang=typescript", "--schema", "public", `--remote=${dbUrl}`],
  { encoding: "utf8", maxBuffer: 32 * 1024 * 1024 },
);

const scrub = (s: string | null) => (s ?? "").replaceAll(dbUrl, "postgresql://***");
if (result.status !== 0 || !result.stdout.includes("export type Database")) {
  console.error("Type generation failed:");
  console.error([scrub(result.stdout), scrub(result.stderr)].filter(Boolean).join("\n"));
  process.exit(1);
}

const header =
  "// Generated by `npm run db:types` from the live Supabase schema. Do not edit by hand —\n" +
  "// change a migration in supabase/migrations/, push it, then regenerate.\n\n";
const target = join("src", "types", "database.ts");
writeFileSync(target, header + result.stdout.trimEnd() + "\n");
console.log(`Wrote ${target}`);
